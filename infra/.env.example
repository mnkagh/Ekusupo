# Copy to `infra/.env` — that file is gitignored and must never be
# committed. Read by `docker compose --env-file infra/.env`.

# --- Required ---------------------------------------------------------
# 32 bytes, hex-encoded. Encrypts provider tokens at rest (AES-256-GCM,
# ADR-0025). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing it makes every stored connection undecryptable, so users have
# to reconnect. Keep it stable; keep it secret.
PROVIDER_TOKEN_ENCRYPTION_KEY=

# --- Where things live ------------------------------------------------
# These four must agree with each other and with the redirect URIs
# registered with each provider, or OAuth fails with a confusing 401.
WEB_APP_URL=http://localhost:8080
VITE_API_BASE_URL=http://localhost:3000

# Only when a proxy you control overwrites X-Forwarded-For (ADR-0033).
# On without one lets anyone forge their address past the sign-in limit.
TRUST_PROXY=false

# --- Providers (all optional; each is unusable until filled in) --------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/providers/spotify/callback

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/providers/youtube-music/callback

APPLE_MUSIC_DEVELOPER_TOKEN=
