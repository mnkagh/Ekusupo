# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# Local dev defaults shown — safe to leave unset for auth-only testing.
PORT=3000
DATABASE_PATH=./data/ekusupo-db
WEB_APP_URL=http://localhost:5173

# Required before storing any provider connection at all — a real,
# random 32-byte key, hex-encoded (64 hex characters). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PROVIDER_TOKEN_ENCRYPTION_KEY=

# Required only for /providers/spotify/connect to work — register an app
# at https://developer.spotify.com/dashboard, add
# http://localhost:3000/providers/spotify/callback as a redirect URI
# there, then fill these in. See docs/decisions/0025-provider-connections.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/providers/spotify/callback
