# Copy to `services/api/.env` — that file is gitignored and must never be
# committed. Both `pnpm dev` and `pnpm start` load it automatically.

# --- Required for provider connections -------------------------------
# 32 bytes, hex-encoded. Encrypts provider tokens at rest (AES-256-GCM,
# ADR-0025). Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Changing this makes every already-stored connection undecryptable, so
# users have to reconnect. Keep it stable; keep it secret.
PROVIDER_TOKEN_ENCRYPTION_KEY=

# --- Spotify -----------------------------------------------------------
# From https://developer.spotify.com/dashboard — create an app, then add
# the redirect URI below to that app's settings *exactly* as written.
#
# These power BOTH paths (ADR-0028):
#   - users connecting their own account, to reach private playlists
#   - reading PUBLIC playlists with nobody connected at all
# Spotify has no anonymous API, so even the public path needs them. With
# these blank, transfers refuse entirely.
#
# SPOTIFY_REDIRECT_URI matters only for the connect flow; the public
# path never redirects anywhere.
#
# Do not mix `localhost` and `127.0.0.1`. Browsers treat them as
# different hosts, so the session and CSRF cookies set on one are never
# sent to the other and the callback fails with a confusing 401. Spotify
# requires the IP literal for new apps, so use 127.0.0.1 everywhere --
# including the address you actually type in the browser. See
# docs/running-and-testing.md §4.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/providers/spotify/callback

# --- Optional --------------------------------------------------------
PORT=3000
# Where the Vite dev server runs. Sets the CORS origin and is where the
# OAuth callback redirects back to. Must use the same host name as
# SPOTIFY_REDIRECT_URI above (and as apps/web's VITE_API_BASE_URL).
WEB_APP_URL=http://127.0.0.1:5173
# On-disk pglite directory (ADR-0024). Delete it to reset all data.
DATABASE_PATH=./data/ekusupo-db

# --- YouTube Music ---------------------------------------------------
# From https://console.cloud.google.com — create an OAuth 2.0 Client ID
# (Web application), enable the YouTube Data API v3, and add the redirect
# URI below to the client's authorised redirect URIs.
#
# Only read scope is requested (youtube.readonly), because the product
# cannot yet write to YouTube. See docs/decisions/0029-provider-registry.md.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:3000/providers/youtube-music/callback

# --- Apple Music -----------------------------------------------------
# A developer token: a JWT you sign with a private key from a paid Apple
# Developer account (MusicKit key). It is minted out of band — this
# server never generates one.
#
# Grants catalogue access only. Reading a listener's own library also
# needs a Music-User-Token from MusicKit in the browser, which this
# server does not obtain.
APPLE_MUSIC_DEVELOPER_TOKEN=
